@using HaFT.Utilities.Razor.Models

@model HaFT.Utilities.Razor.Models.Table

@{
	var sortRules = Model.SortRules;
	var hasMultipleSortColumns = sortRules.Count > 1;
}

<table class="table table-bordered table-striped table-hover m-0">

	<thead class="thead-dark">
	<tr>
		@{
			var columnIndex = 0;
			foreach (var col in Model.Columns)
			{
				var header = col.Header;
				var cls = col.Alignment switch
				{
					HorizontalAlignment.Center => "text-center",
					HorizontalAlignment.Right => "text-end",
					_ => null
				};

				<th class="@cls">
					@if (col.IsSortable)
					{
						<div style="display: flex">
							<div style="flex: 1">@Html.Raw(header)</div>

								@{
									int? sortOrderNumber = null;
									string html;
									string? callback;
									var sortRuleIndex = sortRules.FindIndex(r => r.Column == col);
									if (sortRuleIndex != -1)
									{
										var rule = sortRules[sortRuleIndex];
										if (rule.Direction == SortDirection.Ascending)
										{
											html = Model.SortUpHtml;
											callback = Model.SortDownCallBack;
										}
										else
										{
											html = Model.SortDownHtml;
											callback = Model.ClearSortCallBack;
										}

										if (hasMultipleSortColumns)
											sortOrderNumber = sortRuleIndex + 1;
									}
									else
									{
										html = Model.SortHtml;
										callback = Model.SortUpCallBack;
									}

									var onclick = callback == null ? null : $"{callback}({columnIndex}, event)";
								}

							<div style="width: 0.8em; cursor: pointer" onclick="@onclick">@Html.Raw(html)</div>
							
							@if (sortOrderNumber != null) { @Html.Raw(Model.GetSortNumberHTML(sortOrderNumber.Value)) }
						</div>
					}
					else
					{
						@Html.Raw(header)
					}
				</th>

				columnIndex++;
			}
		}
	</tr>
	</thead>

	<tbody>
		<partial name="TableRows" model="Model" />
	</tbody>
</table>
