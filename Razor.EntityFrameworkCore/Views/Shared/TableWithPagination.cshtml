@model Pages.TablePageModel

@{
	var uid = $"div_{Guid.NewGuid():N}";

	<input asp-for="SortRulesJson" />

	await write("align-items-end");

	<div id="@uid" class="row">
		<partial name="Table" model="Model.Table"/>
	</div>

	await write("align-items-start");

	async Task write(string alignment)
	{
		<div class="row my-1">
			<div class="col-9 d-flex @alignment p-0">@Model.Statistics - @Model.FilterText</div>
			<div class="col-3 d-flex justify-content-end p-0">
				<nav>
					<ul class="pagination m-0">
						<li class="page-item @(Model.IsPrevEnabled ? "" : "disabled")"><button class="page-link" type="submit" asp-page-handler="Prev" form="@Model.FormId">Previous</button></li>
						<li class="page-item @(Model.IsNextEnabled ? "" : "disabled")"><button class="page-link" type="submit" asp-page-handler="Next" form="@Model.FormId">Next</button></li>
					</ul>
				</nav>
			</div>
		</div>
	}
}
<script>
	var HaFT = HaFT || {};
	HaFT.Razor = HaFT.Razor || {};
	HaFT.Razor.EntityFrameworkCore = HaFT.Razor.EntityFrameworkCore || {};


	HaFT.Razor.EntityFrameworkCore.TableWithPagination = function() {
		let sortRules = JSON.parse(document.getElementById("SortRulesJson").value);

		function newRule(columnIndex, isAscending) { return { columnIndex, isAscending } }

		return {
			sortUp: function(ndx, event) {
				const rule = newRule(ndx, true);
				
				if (event.shiftKey) sortRules.push(rule);
				else sortRules = [rule];

				this.submitForm();
			},
			sortDown: function(ndx, event) {
				if (event.shiftKey) sortRules.find(rule => rule.columnIndex == ndx).isAscending = false;
				else sortRules = [newRule(ndx, false)];

				this.submitForm();
			},
			clearSort: function(ndx, event) {
				if (event.shiftKey) sortRules = sortRules.filter(rule => rule.columnIndex != ndx);
				else sortRules = [];

				this.submitForm();
			},
			submitForm: function() {
				$("#SortRulesJson").val(JSON.stringify(sortRules));
				const form =
				@if (Model.FormId == null)
				{
				@: $("#@uid").closest("form");
				}
				else
				{
				@: $("#@Model.FormId");
				}
				form.submit();
			}
		};
	}();
</script>
